# Free-tier Gemini API key; add only as a server-side Vercel environment variable.
# Never use a VITE_ prefix or commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Vite preview uses Ollama (run `ollama serve` first).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

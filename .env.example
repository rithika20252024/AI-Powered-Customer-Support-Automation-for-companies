# Optional: Vercel AI Gateway API key for local/non-Vercel deployments.
# Vercel deployments can use the automatically provided VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Local Vite preview uses Ollama (run `ollama serve` first).
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
